   "source": [
    "from jupyturtle import make_turtle, forward, left\n",
    "\n",
    "def polygon(sides, length) :\n",
    "    for _ in range(sides) :\n",
    "\n",
    "        forward(length)\n",
    "        left(360/sides)\n",
    "\n",
    "make_turtle(width=700, height=600, delay=0.002)\n",
    "polygon(300, 3)\n"
   ]
